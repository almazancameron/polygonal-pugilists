[ext_resource type="Script" path="res://scripts/technique/heal_action.gd" id="7_heal"]
[ext_resource type="Script" path="res://scripts/numeric_bonus/numeric_bonus.gd" id="8_bonus"]
[ext_resource type="Script" path="res://scripts/technique/status_application_action.gd" id="9_status"]

[sub_resource type="Resource" id="Resource_halve_infestation"]
script = ExtResource("6_modify")
effect = 9
modifier = 0.5
metadata/_custom_type_script = "uid://6w0wvj8mfwna"

[sub_resource type="Resource" id="Resource_heal_action"]
script = ExtResource("7_heal")
metadata/_custom_type_script = "uid://b0y2qhaakxlsw"

[sub_resource type="Resource" id="Resource_target_infested"]
script = ExtResource("5_statuscond")
left_status_effect = 9
left_target = 1
right_value = 1
comparator = 1
metadata/_custom_type_script = "uid://brxa3r56ukm5t"

[sub_resource type="Resource" id="Resource_heal_bonus"]
script = ExtResource("8_bonus")
applies_to = 2
percent_bonus = 2.0
percent_source = 1
percent_target = 1
percent_status_effect = 9
metadata/_custom_type_script = "uid://3qq8130hhesh"

[sub_resource type="Resource" id="Resource_reap_group"]
script = ExtResource("2_group")
actions = Array[ExtResource("3_action")]([SubResource("Resource_halve_infestation"), SubResource("Resource_heal_action")])
conditions = Array[ExtResource("4_condition")]([SubResource("Resource_target_infested")])
numeric_bonuses = Array[ExtResource("8_bonus")]([SubResource("Resource_heal_bonus")])
metadata/_custom_type_script = "uid://bxo68i5nl228w"

[sub_resource type="Resource" id="Resource_apply_infestation"]
