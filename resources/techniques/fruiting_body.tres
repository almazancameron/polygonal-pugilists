left_target = 1
comparator = 3
metadata/_custom_type_script = "uid://brxa3r56ukm5t"

[sub_resource type="Resource" id="Resource_sow_group"]
script = ExtResource("2_group")
actions = Array[ExtResource("3_action")]([SubResource("Resource_apply_infestation")])
conditions = Array[ExtResource("4_condition")]([SubResource("Resource_target_not_infested")])
metadata/_custom_type_script = "uid://bxo68i5nl228w"

[resource]
script = ExtResource("1_tech")
technique_name = "Fruiting Body"
step_groups = Array[ExtResource("2_group")]([SubResource("Resource_reap_group"), SubResource("Resource_sow_group")])
