[gd_resource type="Resource" script_class="Technique" format=3]

[ext_resource type="Script" path="res://scripts/technique/technique.gd" id="1_tech"]
[ext_resource type="Script" path="res://scripts/technique/technique_step_group.gd" id="2_group"]
[ext_resource type="Script" path="res://scripts/technique/technique_action.gd" id="3_action"]
[ext_resource type="Script" path="res://scripts/condition/condition.gd" id="4_condition"]
